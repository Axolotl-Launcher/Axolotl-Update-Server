# SQLite is for local development; its Go driver needs CGO and GCC.
APP_ENV=development
DATABASE_URL=sqlite://instance/update-server.db
# Production: APP_ENV=production; run db migrate explicitly.
# DATABASE_URL=postgres://axolotl:password@127.0.0.1:5432/axolotl?sslmode=disable
DIST_ROOT=./dist
PUBLIC_BASE_URL=https://update.axlmc.org
# Empty stores/serves packages locally (latest 3 published versions per channel).
# Nonempty keeps the optional external distribution redirect mode.
DIST_SERVER=
# Only /dist/* requires a Cloudflare connection. Disable for local debugging.
DIST_CLOUDFLARE_ONLY=true
# Optional >=32-character secret overwritten by your Cloudflare request-header rule.
# Header name: X-Axolotl-Origin-Secret. Never put it in download URLs.
DIST_ORIGIN_SECRET=
UPDATE_SERVER_HOST=127.0.0.1
UPDATE_SERVER_PORT=8082
ADMIN_TOKEN=change-admin-token
WEBHOOK_SECRET=change-webhook-secret
MAX_UPLOAD_SIZE=536870912
WEBHOOK_MAX_AGE_SECONDS=300
RATE_LIMIT_PER_MINUTE=120
LATEST_CACHE_SECONDS=30
# Enable only when CDN cache keys include all three X-Axolotl headers.
LATEST_CDN_HEADER_CACHE_KEY=false
# Empty disables forwarded-header trust. Add only actual proxy addresses.
# TRUSTED_PROXY_CIDRS=127.0.0.1/32,::1/128
GITHUB_DOWNLOAD_CONNECT_TIMEOUT_SECONDS=10
GITHUB_DOWNLOAD_READ_TIMEOUT_SECONDS=60
GITHUB_DOWNLOAD_RETRIES=3
GITHUB_ARTIFACT_DOWNLOAD_TIMEOUT_SECONDS=1800
ANALYTICS_ENABLED=true
ANALYTICS_QUEUE_SIZE=10000
ANALYTICS_BATCH_SIZE=500
ANALYTICS_FLUSH_SECONDS=1
ANALYTICS_SHUTDOWN_SECONDS=10
# Local GeoLite2/GeoIP2-compatible MMDB files; empty leaves geography/ASN unknown.
ANALYTICS_GEOIP_CITY_DB=
ANALYTICS_GEOIP_ASN_DB=
# Same domestic lookup source as hjfunnyMC: China prefers QQWry IPDB (CN language).
ANALYTICS_QQWRY_DB=
# Optional ip-api-compatible fallback; empty disables network queries.
# Shares a rolling 40 requests/60s limit across serve/relocate using this database.
# ANALYTICS_GEOIP_API_URL=http://ip-api.com/json/{ip}?lang=zh-CN&fields=status,countryCode,continentCode,regionName,city
ANALYTICS_GEOIP_API_URL=
# Exclude dashboard polling from request statistics by default.
ANALYTICS_INCLUDE_STATS_REQUESTS=false
STATS_QUERY_TIMEOUT_SECONDS=15

