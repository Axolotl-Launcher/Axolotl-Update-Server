# Merge this servers block into an existing global block if needed.
{
	servers {
		# Official Cloudflare IPv4/IPv6 ranges; review when Cloudflare updates them.
		trusted_proxies static 173.245.48.0/20 103.21.244.0/22 103.22.200.0/22 103.31.4.0/22 141.101.64.0/18 108.162.192.0/18 190.93.240.0/20 188.114.96.0/20 197.234.240.0/22 198.41.128.0/17 162.158.0.0/15 104.16.0.0/13 104.24.0.0/14 172.64.0.0/13 131.0.72.0/22 2400:cb00::/32 2606:4700::/32 2803:f800::/32 2405:b500::/32 2405:8100::/32 2a06:98c0::/29 2c0f:f248::/32
		client_ip_headers CF-Connecting-IP
		trusted_proxies_strict
	}
}

(client_ip_upstream) {
	# Replace the incoming chain with Caddy's verified client address.
	header_up X-Forwarded-For {client_ip}
	header_up X-Real-IP {client_ip}
	header_up -CF-Connecting-IP
}

http://update.axlmc.org https://update.axlmc.org {
	root * /www/wwwroot/update.axlmc.org
	encode gzip
	log {
		output stderr
		format json
	}
	header {
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "no-referrer"
	}
	handle /api/* {
		reverse_proxy 127.0.0.1:8082 {
			import client_ip_upstream
		}
		header Cache-Control "no-store"
	}
	handle /latest {
		reverse_proxy 127.0.0.1:8082 {
			import client_ip_upstream
		}
		header Cache-Control "no-cache, max-age=0, must-revalidate"
	}
	@stored_dist_file {
		path /dist/*
		file {path}
	}
	handle @stored_dist_file {
		file_server
		header Cache-Control "public, max-age=31536000, immutable"
	}
	# Missing, pruned dist files are handled by Flask and may redirect to GitHub.
	handle /dist/* {
		reverse_proxy 127.0.0.1:8082 {
			import client_ip_upstream
		}
	}
}
