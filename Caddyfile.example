(client_ip_upstream) {
	# Compatible with older Caddy: Flask verifies this peer before trusting CF headers.
	header_up X-Forwarded-For {http.request.remote.host}
}

http://update.axlmc.org https://update.axlmc.org {
	root * /www/wwwroot/update.axlmc.org
	encode gzip
	log {
		output stderr
		format json
	}
	header {
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "no-referrer"
	}
	handle /api/* {
		reverse_proxy 127.0.0.1:8082 {
			import client_ip_upstream
		}
		header Cache-Control "no-store"
	}
	handle /latest {
		reverse_proxy 127.0.0.1:8082 {
			import client_ip_upstream
		}
		# Preserve origin Cache-Control, Cloudflare-CDN-Cache-Control and Vary.
	}
	handle /dist/* {
		@stored_dist_file file {path}
		handle @stored_dist_file {
			file_server
			header Cache-Control "public, max-age=31536000, immutable"
		}
		# Missing, pruned dist files may redirect to GitHub.
		handle {
			reverse_proxy 127.0.0.1:8082 {
				import client_ip_upstream
			}
		}
	}
}
